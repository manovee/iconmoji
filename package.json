{
  "name": "@manovee/iconmoji",
  "version": "0.1.0",
  "description": "A lightweight icon picker for React and Next.js apps with Lucide and emoji support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Manohar V <manovee@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovee/iconmoji.git"
  },
  "homepage": "https://manovee.github.io/iconmoji/",
  "bugs": {
    "url": "https://github.com/manovee/iconmoji/issues"
  },
  "sideEffects": [
    "./dist/styles.css",
    "*.css"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup && node scripts/copy-css.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "preview": "npm run build && python3 -m http.server 4173",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "icon-picker",
    "react",
    "nextjs",
    "lucide",
    "emoji",
    "shadcn",
    "lucide-react",
    "emoji-picker",
    "icon-select",
    "ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lucide-react": "^0.522.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
